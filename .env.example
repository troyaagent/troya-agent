# Optional settings, read from the environment. Copy to .env (never commit it) and start with:
#   node --env-file=.env server.mjs
# Markets, quotes and Troya Gate run without any of these.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# LLM_DAILY_USD=5
# TROYA_MASTER_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_POLL=0
# ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
# PORT=9270
# HOST=127.0.0.1
