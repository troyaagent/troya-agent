# Only the app itself is public. Everything else (data, media, content, keys, deploy) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/.env.example
!/package.json
!/package-lock.json
!/server.mjs
!/server/
!/public/
!/mcp/
!/tools/
!/.github/
/public/_*/
/tools/*
!/tools/crawl.mjs
!/tools/sentry-filter-test.mjs
!/tools/rh-smoke.mjs
!/tools/fetch-lighter-signer.sh
!/tools/regate-test.mjs
!/tools/tgtrade-test.mjs
!/tools/holders-test.mjs
!/tools/tgmod-test.mjs
!/tools/botcmds-test.mjs
!/tools/security-test.mjs
!/tools/hlfund-test.mjs
!/tools/mcp-test.mjs
!/tools/playbook-test.mjs
!/tools/bridge-hl-ui-test.mjs
!/tools/tgterm-test.mjs
!/tools/brief-test.mjs
!/tools/autopilot-test.mjs
!/tools/onboard-test.mjs
!/tools/autopilot-live-test.mjs
!/tools/guest-test.mjs
!/tools/build-proof.mjs
node_modules/
.DS_Store
.env
.env.*
!/.env.example
*.log
# Lighter's official signer (lighter-go v1.0.12, lighter-signer-web.wasm, sha256 95c9dd38373405691498c52c0feb72338e6bb00e90362227efe59fb12523c5ae)
# is 7.6 MB: fetch it with tools/fetch-lighter-signer.sh instead of keeping it in git
/public/vendor/lighter/*.wasm
/public/vendor/lighter/*.wasm.gz
