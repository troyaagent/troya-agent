{
  "name": "@troyaagent/game-plugin",
  "version": "0.1.2",
  "description": "Virtuals GAME (game-node) plugin for Troya: a worker with read-only Robinhood Chain safety functions (Gate pre-trade check, Trident firewall, Scylla bridge safety, Bow agent passport, Heel weak spot, Sirens real depth). Never trades or signs.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@troyaagent/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "@virtuals-protocol/game": ">=0.1.14 <1"
  },
  "keywords": [
    "virtuals",
    "game",
    "game-node",
    "virtuals-protocol",
    "plugin",
    "troya",
    "robinhood-chain",
    "ai-agent",
    "token-safety"
  ],
  "homepage": "https://troya.codes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troyaagent/troya-agent.git",
    "directory": "plugins/virtuals-game"
  },
  "bugs": {
    "url": "https://github.com/troyaagent/troya-agent/issues"
  },
  "license": "MIT"
}
